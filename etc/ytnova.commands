######################################
# commands.conf starter for YtreeNova command customization.
#
# This is the package's default command set.
# YtreeNova uses it when commands.conf does not select a preset.
# If you want to change what ships by default, edit this file.
# If you want to change what "preset = en" means, edit etc/commands/en.conf
# instead.
#
# Only --init and explicit F10 Commands create this file. When the file is
# missing, YtreeNova falls back to the packaged active command map without
# creating a user copy.
#
# Optional preset selector:
#   preset = de
#
# Canonical structure:
#   [DIR]
#   binding | shown | label | action | command
#
#   [ARCHIVE_DIR]
#   binding | shown | label | action | command
#
#   [FILE]
#   binding | shown | label | action | command
#
#   [ARCHIVE_FILE]
#   binding | shown | label | action | command
#
# Rules:
# - section headers are stable runtime command-surface IDs, not locale names.
# - preset selects one packaged read-only preset by stable ID before local rows.
# - binding is the real input key (single keys or Ctrl+letter chords).
# - shown is the token rendered in footer keybinding/F1 surfaces.
# - label is plain user-visible text only; do not encode key markup here.
# - action is the stable internal action ID; do not translate or rename it.
# - command is blank for built-ins. Use action user-command for custom shell
#   commands and put the shell command in the final column.
# - Uppercase and lowercase letters may be bound separately.
# - Ctrl+letter bindings are case-insensitive, so Ctrl+n and Ctrl+N are the
#   same chord.
#
# Built-in rows below mirror the packaged default visible command keys. Editing
# them lets commands.conf override the packaged active command map cleanly.
######################################
[DIR]
# binding | shown | label | action | command
A | A | Attributes | ACTION_CMD_A |
C | C | Copy | ACTION_CMD_C |
D | D | Delete | ACTION_CMD_D |
F | F | Filter | ACTION_FILTER |
G | G | Global | ACTION_CMD_G |
I | I | Invert | ACTION_INVERT |
J | J | Compare | ACTION_COMPARE_DIR |
L | L | Log | ACTION_LOG |
M | M | Makedir | ACTION_CMD_M |
N | N | Newfile | ACTION_CMD_MKFILE |
O | O | Only tagged | ACTION_TOGGLE_TAGGED_MODE |
P | P | Pipe | ACTION_CMD_P |
Q | Q | Quit | ACTION_QUIT |
R | R | Rename | ACTION_CMD_R |
S | S | Showall | ACTION_CMD_S |
T | T | Tag | ACTION_TAG |
U | U | Untag | ACTION_UNTAG |
V | V | Movedir | ACTION_CMD_V |
W | W | Write | ACTION_CMD_PRINT |
X | X | Execute | ACTION_CMD_X |
Z | Z | Archive | ACTION_CMD_I |
/ | / | Jump | ACTION_LIST_JUMP |
` | ` | Dotfiles | ACTION_TOGGLE_HIDDEN |

[ARCHIVE_DIR]
# binding | shown | label | action | command
C | C | Copy | ACTION_CMD_C |
D | D | Delete | ACTION_CMD_D |
F | F | Filter | ACTION_FILTER |
G | G | Global | ACTION_CMD_G |
J | J | Compare | ACTION_COMPARE_DIR |
L | L | Log | ACTION_LOG |
M | M | Makedir | ACTION_CMD_M |
P | P | Pipe | ACTION_CMD_P |
Q | Q | Quit | ACTION_QUIT |
R | R | Rename | ACTION_CMD_R |
S | S | Showall | ACTION_CMD_S |
T | T | Tag | ACTION_TAG |
U | U | Untag | ACTION_UNTAG |
V | V | Movedir | ACTION_CMD_V |
/ | / | Jump | ACTION_LIST_JUMP |
` | ` | Dotfiles | ACTION_TOGGLE_HIDDEN |

[FILE]
# binding | shown | label | action | command
A | A | Attributes | ACTION_CMD_A |
C | C | Copy | ACTION_CMD_C |
Ctrl+K | ^K | Copy tagged | ACTION_CMD_TAGGED_C |
D | D | Delete | ACTION_CMD_D |
E | E | Edit | ACTION_CMD_E |
F | F | Filter | ACTION_FILTER |
H | H | Hex | ACTION_CMD_H |
I | I | Invert | ACTION_INVERT |
J | J | Compare | ACTION_COMPARE_FILE |
L | L | Log | ACTION_LOG |
M | M | Move | ACTION_CMD_M |
Ctrl+N | ^N | Move tagged | ACTION_CMD_TAGGED_M |
N | N | Newfile | ACTION_CMD_MKFILE |
O | O | Only tagged | ACTION_TOGGLE_TAGGED_MODE |
P | P | Pipe | ACTION_CMD_P |
Q | Q | Quit | ACTION_QUIT |
R | R | Rename | ACTION_CMD_R |
S | S | Sort | ACTION_CMD_S |
W | W | Write | ACTION_CMD_PRINT |
X | X | Execute | ACTION_CMD_X |
Y | Y | Pathcopy | ACTION_CMD_Y |
Z | Z | Archive | ACTION_CMD_I |
/ | / | Jump | ACTION_LIST_JUMP |
` | ` | Dotfiles | ACTION_TOGGLE_HIDDEN |

[ARCHIVE_FILE]
# binding | shown | label | action | command
C | C | Copy | ACTION_CMD_C |
D | D | Delete | ACTION_CMD_D |
F | F | Filter | ACTION_FILTER |
H | H | Hex | ACTION_CMD_H |
I | I | Invert | ACTION_INVERT |
J | J | Compare | ACTION_COMPARE_FILE |
M | M | Move | ACTION_CMD_M |
P | P | Pipe | ACTION_CMD_P |
R | R | Rename | ACTION_CMD_R |
S | S | Sort | ACTION_CMD_S |
T | T | Tag | ACTION_TAG |
U | U | Untag | ACTION_UNTAG |
Y | Y | Pathcopy | ACTION_CMD_Y |
/ | / | Jump | ACTION_LIST_JUMP |
` | ` | Dotfiles | ACTION_TOGGLE_HIDDEN |

# Example custom shell-command row:
# [FILE]
# K | K | Disk usage | user-command | du %s | less
