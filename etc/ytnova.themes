# YtreeNova semantic themes.
#
# Copy this file to ~/.config/ytnova/themes.conf for user-specific themes.
# The home-directory fallback path is ~/.ytnova.themes when the XDG target
# cannot be used.
#
# Role syntax:
#   foreground
#   +foreground
#   foreground on background
#   +foreground on +background
#
# File-type palettes are optional per theme. Rule order is significant: the
# first matching selector wins. Omitted backgrounds inherit from the active
# filename/window background.

[theme classic-blue]
background = blue
box_lines = cyan on blue
tree_lines = +white on blue
margin = dynamic_text
static_text = white on blue
dynamic_text = +white on blue
keybind = +white on blue
selection = black on +grey
dialog = black on +grey
picker = black on +grey
help = white on blue
info = +white on blue
warning = black on yellow
error = +white on red
search_hit = black on yellow
disabled = grey on blue

[file-types classic-blue]

[theme bash-black]
background = black
box_lines = grey on black
tree_lines = white on black
margin = dynamic_text
static_text = white on black
dynamic_text = +white on black
keybind = +white on black
selection = black on yellow
dialog = white on black
picker = black on yellow
help = white on black
info = +white on blue
warning = black on yellow
error = +white on red
search_hit = black on yellow
disabled = grey on black

[file-types bash-black]
archives = red: tar,tgz,zip,gz,rar,7z,iso
scripts = +cyan: sh,bash,py,pl,rb
code = green: c,h,cpp,rs,go,java,js,ts
media = magenta: jpg,png,gif,mp4,mp3,wav
documents = white: pdf,txt,md,doc,docx
links = cyan: LINK
executables = green: EXEC
