# YtreeNova semantic themes.
#
# Copy this file to ~/.config/ytnova/themes.conf for user-specific themes.
# The home-directory fallback path is ~/.ytnova.themes when the XDG target
# cannot be used.
#
# Role syntax:
#   foreground
#   +foreground
#   foreground on background
#   +foreground on +background
#
# File-type palettes are optional per theme. Rule order is significant: the
# first matching selector wins. Omitted backgrounds inherit from the active
# filename/window background.

[theme norton-blue]
background = blue
static_text = white
dynamic_text = +white
margin = dynamic_text
dialog = white
box_lines = white
tree_lines = white
keybind = yellow
footer = white
help = black on grey
help_link = black on cyan
help_link_selection = yellow on cyan
selection = black on cyan
picker = white on cyan
picker_selection = white on black
info = black on cyan
warning = black on yellow
error = +white on red
search_hit = black on yellow

[file-types orthodox-blue]
archives = +green: 7z,Z,aab,aar,ace,apk,arc,arj,ark,bz2,cab,cpio,deb,gz,lha,lz,lz4,lzh,lzma,lzo,rar,rpm,tar,tbz,tbz2,tgz,tlz,txz,tzo,tzst,vsix,xapk,xz,zip,zoo,zst
scripts = +cyan: sh,bash,py,pl,pm,rb,awk,bat,cmd,cgi,js,mjs,tcl,tk,ps1,lua
code = cyan: c,h,cc,hh,cpp,cxx,hpp,asm,java,jav,jasm,go,rs,cs,ts,tsx,php,phps,pas,inc,m4,st,mak,sl,ada,caml,ml,mli,mly,mll,mlp,sas,prg,hs,hi,erl,swift,diff,patch
audio = green: mp3,wav,flac,ogg,m4a,wma,aac,mid,midi,ac3,ape,awb,dts,it,med,mod,s3m,umx,xm,opus
video = green: mp4,avi,mkv,mov,wmv,flv,webm,3gp,asf,m4v,mol,mpl,mp2,mpeg,mpg,ogv,ts,vob,y4m
graphics = +magenta: jpg,jpeg,gif,png,tif,tiff,pcx,bmp,xpm,xbm,eps,pic,rle,ico,wmf,omf,ai,cdr,svg,dwg,avif,heic,heif,hif,jp2,jxl,psb,psd,xcf,webp
documents = yellow: pdf,txt,md,markdown,doc,docx,rtf,chm,css,ctl,diz,docm,dtd,fodg,fodp,fods,fodt,htm,html,json,letter,lsm,mail,man,me,mkd,msg,nroff,odg,odp,ods,odt,po,ppt,pptm,pptx,ps,sgml,shtml,tex,text,xls,xlsm,xlsx,xml,xsd,xslt,yaml,toml
links = grey: LINK
executables = +green: EXEC

[theme quiet-blue]
background = blue
box_lines = cyan
tree_lines = +white
static_text = white
dynamic_text = +white
margin = dynamic_text
keybind = +white
footer = white
selection = black on white
dialog = white
picker = black on cyan
picker_selection = selection
help = white
help_link = cyan
help_link_selection = yellow
info = black on cyan
warning = black on yellow
error = +white on red
search_hit = black on yellow

[file-types quiet-blue]
archives = red: tar,tgz,zip,gz,rar,7z,iso
scripts = +cyan: sh,bash,py,pl,rb
code = yellow: c,h,cpp,rs,go,java,js,ts
media = magenta: jpg,png,gif,mp4,mp3,wav
documents = white: pdf,txt,md,doc,docx
links = cyan: LINK
executables = green: EXEC

[theme bash-black]
background = black
box_lines = grey
tree_lines = white
static_text = white
dynamic_text = +white
margin = dynamic_text
keybind = +white
footer = white
selection = black on white
dialog = white
picker = black on grey
picker_selection = selection
help = white
help_link = cyan
help_link_selection = yellow
info = white on blue
warning = black on yellow
error = white on red
search_hit = black on yellow

[file-types bash-black]
archives = red: tar,tgz,zip,gz,rar,7z,iso
scripts = +cyan: sh,bash,py,pl,rb
code = green: c,h,cpp,rs,go,java,js,ts
media = magenta: jpg,png,gif,mp4,mp3,wav
documents = white: pdf,txt,md,doc,docx
links = cyan: LINK
executables = green: EXEC
